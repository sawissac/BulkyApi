: "L83"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "map", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L148"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "(() => {\n            const count = builtCalls.length;\n            const overflow = count > 4;\n            const heat = count > 10;\n            const heatLevel = heat ? Math.min(1, (count - 10) / 20) : 0;\n            const dots = builtCalls.slice(0, 4);\n            return dots.map((c, i) => {\n              let bg =\n                c.status === \"idle\"\n                  ? T.border\n                  : c.status === \"pending\"\n                    ? T.cyan\n                    : statusColor(c.statusCode, T);\n              if (heat) {\n                const t = Math.min(\n                  1,\n                  heatLevel + (i / 3) * (1 - heatLevel) * 0.6,\n                );\n                const r = Math.round(220 * t + 0 * (1 - t));\n                const g = Math.round(50 * t + 200 * (1 - t));\n                const b = Math.round(50 * t + 160 * (1 - t));\n                bg = `rgb(${r},${g},${b})`;\n              } else if (overflow) {\n                const gradients = [T.cyan, T.warn, T.error, T.error];\n                bg = gradients[i] ?? T.error;\n              }\n              return (\n                <div\n                  key={i}\n                  style={{\n                    width: 6,\n                    height: 6,\n                    borderRadius: \"50%\",\n                    background: bg,\n                    transition: \"background 0.6s\",\n                    opacity: c.status === \"idle\" ? 0.35 : 1,\n                    animation:\n                      c.status === \"pending\"\n                        ? \"pulse 0.8s ease-in-out infinite\"\n                        : undefined,\n                  }}\n                />\n              );\n            });\n          })", "is_member_call": false, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L193"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "map", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L282"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "keys", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L290"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "map", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L360"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "entries", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L360"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "map", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L497"}]}