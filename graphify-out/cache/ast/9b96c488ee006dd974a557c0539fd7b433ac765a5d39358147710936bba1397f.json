n              return (\n                <div\n                  key={i}\n                  style={{ width: 6, height: 6, borderRadius: '50%', background: bg, transition: 'background 0.6s', opacity: c.status === 'idle' ? 0.35 : 1, animation: c.status === 'pending' ? 'pulse 0.8s ease-in-out infinite' : undefined }}\n                />\n              );\n            });\n          })", "is_member_call": false, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L74"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "map", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L118"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "keys", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L125"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "map", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L151"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "entries", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L151"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "map", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L194"}]}