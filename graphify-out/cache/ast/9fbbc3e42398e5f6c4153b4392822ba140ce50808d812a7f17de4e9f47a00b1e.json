\n  })", "is_member_call": false, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L155"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "map", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L210"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "map", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L251"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "map", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L284"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "keys", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L292"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "map", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L327"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "entries", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L327"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "map", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/BulkyApi/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L401"}]}