# Supabase — copy to .env.local and fill in from your project's API settings.
# Both are public by design: the publishable key is safe in the browser because
# Row Level Security is what actually restricts data access. Never put the
# service_role key in a NEXT_PUBLIC_* variable.
#
# Leave these unset to run BulkyApi local-only (localforage, no sync).
NEXT_PUBLIC_SUPABASE_URL=

# Either name works. The dashboard now hands out PUBLISHABLE_KEY; ANON_KEY is
# the older name for the same value and stays supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── MCP server (mcp/) ───────────────────────────────────────────────────────
# The MCP server signs in as a real BulkyApi user so Row Level Security scopes
# what Claude can read and write. Magic-link accounts start without a password —
# set one at /login while signed in, then put it here. It reuses the two values above, so only the
# credentials are needed here. Leave unset to expose only the tools that need
# no saved state (bulky_http_request, bulky_run_script, bulky_curl_to_script).
BULKY_EMAIL=
BULKY_PASSWORD=

# Optional limits. Defaults: 30000 ms per call, 50 calls per script run,
# 5000 ms of collection per api.sse() stream.
# BULKY_TIMEOUT_MS=30000
# BULKY_MAX_CALLS=50
# BULKY_SSE_WINDOW_MS=5000
